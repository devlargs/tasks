# Notion integration token (https://www.notion.so/my-integrations) — the same
# one Largs Hub's Todo uses. The database must be shared with the integration.
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The task database: its ID or full URL (Largs Hub › Todo › ⚙ › View database in Notion)
NOTION_DATABASE_ID=https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The password you sign in with (8+ characters)
APP_PASSWORD=

# Signs the session cookie. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
