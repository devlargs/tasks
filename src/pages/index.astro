---
import Layout from "../layouts/Layout.astro";
import TasksRoot from "../components/TasksRoot";
import { readConnection } from "../lib/server/connection";
import { notionDatabaseUrl } from "../lib/tasksLogic";

// Whether this device has connected Notion comes from its cookie, which the
// page's scripts can't read. Everything else — today's date, what's cached,
// tasks kept on the device — is per-device state, so the app renders in the
// browser only.
const connection = readConnection(Astro.cookies);
const databaseUrl = connection ? notionDatabaseUrl(connection.databaseId) : null;
---

<Layout title="Tasks">
  <div id="root">
    <TasksRoot client:only="react" connected={connection !== null} databaseUrl={databaseUrl} />
  </div>
</Layout>
