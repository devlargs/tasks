---
import Layout from "../layouts/Layout.astro";

const failed = Astro.url.searchParams.has("error");
---

<Layout title="Tasks · Sign in">
  <main class="login">
    <form method="post" action="/api/login" class="login-card">
      <img src="/favicon.svg" alt="" width="44" height="44" />
      <h1>Tasks</h1>
      <p class="login-sub">Today's list, synced with Largs Hub.</p>
      <label for="password" class="sr-only">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        placeholder="Password"
        required
        autofocus
      />
      {failed && <p class="login-error" role="alert">That password didn't work.</p>}
      <button type="submit">Sign in</button>
    </form>
  </main>
</Layout>

<style>
  .login {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: var(--space-lg) var(--space-md);
    background: var(--surface);
  }

  .login-card {
    width: min(100%, 320px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  .login-card img {
    align-self: flex-start;
  }

  h1 {
    font-size: var(--text-display-s);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .login-sub {
    margin-top: calc(var(--space-xs) * -1);
    margin-bottom: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  input {
    padding: var(--space-sm);
    /* 16px keeps iOS from zooming in on focus */
    font-size: 16px;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--panel) 70%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    border-radius: 8px;
    outline: none;
    transition: border-color var(--dur-short) var(--ease-out);
  }

  input:focus {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .login-error {
    font-size: var(--text-sm);
    color: var(--danger);
  }

  button {
    padding: var(--space-sm);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--surface);
    background: var(--accent);
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
